options {
STATIC = false;
}

PARSER_BEGIN(Compilador)

package dev.napoleon;
import java.util.HashMap;
import java.util.Map;
import java.util.HashSet;
import java.util.Set;

public class Compilador {

    //Mapa para guardar as variáveis da linguagem
    public Map<String, Double> variaveis = new HashMap<>();
    public Set<String> variaveisInteiras = new HashSet<>();

}

PARSER_END(Compilador)

//Analisador Léxico
SKIP : { " " | "\t" | "\r" | "\n" }

//Literais (privados)
TOKEN : {
    < #DIGITO : ["0"-"9"] >
    | < #LETRA_MIN : ["a"-"z"] >
    | < #LETRA_MAI : ["A"-"Z"] >
    | < #SUBLINHADO : "_" >
}

//Números
TOKEN : {
    < NUMERO_REAL : (<DIGITO>)+ ("." (<DIGITO>)+) >
    | < NUMERO_INT : (<DIGITO>)+ >
}

//Operadores Aritméticos (literais)
TOKEN : {
      < SOMA : "+" > 
      | < SUB : "-" >
      | < MULT : "*" >
      | < DIV : "/" > 
      | < APAR : "(" >
      | < FPAR : ")" >
}

//Literais da linguagem
TOKEN : {
     < DEC_TIPO_INT : "inteiro">
    | < DEC_TIPO_REAL : "real">
    | < ATRIB : "=" >
    | < FIM_INST : ";" >
    | < COND_SE : "se" >
    | < COND_SE_NAO : "se_nao" >
}

//Identificador
TOKEN : {
    < IDENTIFICADOR : (<LETRA_MIN> | <LETRA_MAI>) (<LETRA_MIN> | <LETRA_MAI> | <SUBLINHADO> | <DIGITO>)* >
}

//Analisador Sintático e Semântico
double Start() :
{ double resultado; }
{
    (Declaracao() 
    | LOOKAHEAD({ getToken(1).kind == IDENTIFICADOR && getToken(2).kind == ATRIB }) Atribuicao()
    )*
    resultado = Expressao() <EOF>
    { return resultado; }
}

//Declaração de variáveis (tipo int ou double)
void Declaracao() :
{}
{
    DeclaracaoInt() | DeclaracaoReal()
}

void DeclaracaoInt() :
{ Token id; double valor = 0.0; boolean temValor = false; }
{
    <DEC_TIPO_INT> id = <IDENTIFICADOR> ( <ATRIB> valor = Expressao() { temValor = true; } )? <FIM_INST>
    {
        if (variaveis.containsKey(id.image)) {
            throw new RuntimeException(
                "[Linha " + id.beginLine + " coluna " + id.beginColumn +
                "]: Variável já declarada: " + id.image
            );
        }
        if (temValor && valor % 1 != 0) {
            throw new RuntimeException("[Linha " + id.beginLine + " coluna " + id.beginColumn + "]: Variável do tipo inteiro (" + id.image + ") não aceita valor real: " + valor);
        }
        variaveisInteiras.add(id.image);
        variaveis.put(id.image, valor);
    }
}

void DeclaracaoReal() :
{ Token id; double valor = 0.0; }
{
    <DEC_TIPO_REAL> id = <IDENTIFICADOR> ( <ATRIB> valor = Expressao() )? <FIM_INST>
    {
        if (variaveis.containsKey(id.image)) {
            throw new RuntimeException(
                "[Linha " + id.beginLine + " coluna " + id.beginColumn +
                "]: Variável já declarada: " + id.image
            );
        }
        variaveis.put(id.image, valor); 
    }
}

//Atribuição
void Atribuicao() :
{ Token id; double valor; }
{
    id = <IDENTIFICADOR> <ATRIB> valor = Expressao() <FIM_INST>
    {
        if (!variaveis.containsKey(id.image)) {
            throw new RuntimeException("[Linha " + id.beginLine + " coluna " + id.beginColumn + "]: Variável não declarada: " + id.image);
        }
        if (variaveisInteiras.contains(id.image) && valor % 1 != 0) {
            throw new RuntimeException("[Linha " + id.beginLine + " coluna " + id.beginColumn + "]: Variável do tipo inteiro (" + id.image + ") não aceita valor real: " + valor);
        }
        variaveis.put(id.image, valor); 
    }
}

//expressao = termo, {("+"|"-"), termo};
double Expressao() :
{ double valor1, valor2; }
{
    valor1 = Termo()
    (
        <SOMA> valor2 = Termo() { valor1 = valor1 + valor2; } 
        | <SUB> valor2 = Termo() { valor1 = valor1 - valor2; }
    )*
    { return valor1; }
}

//termo = fator, {("*"|"/"), fator};
double Termo() :
{ double valor1, valor2; }
{
    valor1 = Fator() 
    (
        <MULT> valor2 = Fator() { valor1 = valor1 * valor2; } 
        | <DIV> valor2 = Fator() { valor1 = valor1 / valor2; }
    )*
    { return valor1; }
}

//fator = numero|"(", expressao, ")";
double Fator() : 
{ double valor; Token t; }
{
    <APAR> valor = Expressao() <FPAR>
    { return valor; } 
    | (t = <NUMERO_REAL> | t = <NUMERO_INT>)
    { return Double.parseDouble(t.image); }
    | t = <IDENTIFICADOR>
    {
        if (!variaveis.containsKey(t.image)) {
            throw new RuntimeException("[Linha " + t.beginLine + " coluna " + t.beginColumn + "]: Variável não declarada: " + t.image);
        }
        return variaveis.get(t.image); 
    }
}





